<tr>
  <td><%= game.name ?? "" %></td>
  <td><%= game.stability ?? "" %></td>
  <td><%= game.pr_status?.replace("--", "N/A") ?? "" %></td>
  <td><%= game.rating ?? "" %></td>
  <td><%= game.platforms?.join(", ") ?? "" %></td>
  <td>
    <% game.links?.forEach((link, index) => { %>
    <% if(link.uri) { %>
    <a href="<%= link.uri ?? "" %>"><%= link.text ?? "" %></a><%= index !== game.links.length - 1 ? ", " : "" %>
    <% } else { %>
    <span><%=link.text ?? "" %></span>
    <% }}) %>
  </td>
  <td>
    <% game.setup?.forEach((link, index) => { %>
    <% if(link.uri) { %>
    <a href="<%= link.uri ?? "" %>"><%= link.text ?? "" %></a><%= index !== game.setup.length - 1 ? ", " : "" %>
    <% } else { %>
    <span><%=link.text ?? "" %></span>
    <% }}) %>
  </td>
  <td>
    <% game.support?.forEach((link, index) => { %>
    <% if(link.uri) { %>
    <a href="<%= link.uri ?? "" %>"><%= link.text ?? "" %></a><%= index !== game.support.length - 1 ? ", " : "" %>
    <% } else { %>
    <span><%= link.text ?? "" %></span>
    <% }}) %>
  </td>
  <td><%= game.disclosure ?? "" %></td>
</tr>