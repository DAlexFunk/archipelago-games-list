<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Archipelago Games</title>
  <link rel="stylesheet" href="/stylesheets/styles.css">

  <script defer>
    const accepted_games = <%- JSON.stringify(games) %>;
  </script>
  <script type="module" src="/js/index.js" defer></script>
</head>

<body>
  <h1>Here are the games</h1>
  <div id="filters">
    <select name="stability" id="stability-select">
      <option value="Unselected" selected>Unselected</option>
      <option value="Stable">Stable</option>
      <option value="Unstable">Unstable</option>
      <option value="Broken on Main">Broken on Main</option>
    </select>

    <select name="pr-status" id="pr-status-select">
      <option value="Unselected" selected>Unselected</option>
      <option value="In Review">In Review</option>
      <option value="Not PRing">Not PRing</option>
      <option value="Merged">Merged</option>
    </select>

    <select name="rating" id="rating-select">
      <option value="Unselected" selected>Unselected</option>
      <option value="18">18+</option>
      <option value="Not 18">Not 18+</option>
    </select>

    <select name="rating" id="disclosure-select">
      <option value="Unselected" selected>Unselected</option>
      <option value="Unknown">Unknown</option>
      <option value="None">None</option>
      <option value="Consulted">Consulted</option>
      <option value="Minimal">Minimal</option>
      <option value="Moderate">Moderate</option>
      <option value="Extensive">Extensive</option>
    </select>
  </div>

  <div id="steam-search">
    <form action="/" method="post">
      <input type="text" name="steamid" id="steamid" placeholder="Enter Steam ID...">
      <button type="submit">Search</button>
    </form>
    <form action="/" method="get">
      <button type="submit">Clear Steam Games</button>
    </form>
  </div>

  <table id="games-list">
    <tr>
      <th>Game</th>
      <th>Stability</th>
      <th>PR Status</th>
      <th>18+?</th>
      <th>Links &amp; Downloads</th>
      <th>Setup Guides</th>
      <th>Support</th>
      <th>Disclosure</th>
    </tr>
    <% games.forEach(game => { %>
    <%- include("game-item.ejs", { game }) %>
    <% }); %>
  </table>
</body>

</html>