<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Archipelago Games</title>
  <link rel="stylesheet" href="/stylesheets/styles.css">

  <script defer>
    const accepted_games = <%- JSON.stringify(games) %>;
  </script>
  <script type="module" src="/js/index.js" defer></script>
</head>

<body>
  <header>
    <h1>Archipelago Games List</h1>
    <ul id="links">
      <li><a href="https://archipelago.gg/" target="_blank">Archipelago Website</a></li>
      <li><a href="https://docs.google.com/spreadsheets/d/1iuzDTOAvdoNe8Ne8i461qGNucg5OuEoF-Ikqs8aUQZw/edit?gid=1086876441#gid=1086876441" target="_blank">Games Spreadsheet</a></li>
    </ul>
  </header>
  <main>
    <div id="filters">
      <h2>Filters</h2>
      <div id="selects">
        <select name="stability" id="stability-select">
          <option value="Unselected" selected>Stability</option>
          <option value="Stable">Stable</option>
          <option value="Unstable">Unstable</option>
          <option value="Broken on Main">Broken on Main</option>
        </select>
        <select name="pr-status" id="pr-status-select">
          <option value="Unselected" selected>PR Status</option>
          <option value="In Review">In Review</option>
          <option value="Not PRing">Not PRing</option>
          <option value="Merged">Merged</option>
        </select>
        <select name="rating" id="rating-select">
          <option value="Unselected" selected>Rating</option>
          <option value="18">18+</option>
          <option value="Not 18">Not 18+</option>
        </select>
        <select name="disclosure" id="disclosure-select">
          <option value="Unselected" selected>Disclosure</option>
          <option value="Unknown">Unknown</option>
          <option value="None">None</option>
          <option value="Consulted">Consulted</option>
          <option value="Minimal">Minimal</option>
          <option value="Moderate">Moderate</option>
          <option value="Extensive">Extensive</option>
        </select>
        <select name="platform" id="platform-select">
          <option value="Unselected" selected>Platform</option>
          <option value="PC (Microsoft Windows)" class="console">Windows</option>
          <option value="Mac" class="console">Mac</option>
          <option value="Linux" class="console">Linux</option>
          <option value="Web browser" class="console">Web</option>
          <option value="Super Famicom" class="console">Famicom</option>
          <option value="Nintendo Entertainment System" class="console">NES</option>
          <option value="Super Nintendo Entertainment System" class="console">SNES</option>
          <option value="Nintendo 64" class="console">N64</option>
          <option value="Nintendo GameCube" class="console">GameCube</option>
          <option value="Wii" class="console">Wii</option>
          <option value="Wii U" class="console">Wii U</option>
          <option value="Nintendo Switch" class="console">Switch</option>
          <option value="Game Boy" class="console">GB</option>
          <option value="Game Boy Color" class="console">GBC</option>
          <option value="Game Boy Advance" class="console">GBA</option>
          <option value="Nintendo DS" class="console">DS</option>
          <option value="Nintendo DSi" class="console">DSi</option>
          <option value="Nintendo 3DS" class="console">3DS</option>
          <option value="Xbox" class="console">Xbox</option>
          <option value="Xbox 360" class="console">Xbox 360</option>
          <option value="Xbox One" class="console">Xbox One</option>
          <option value="Xbox Series X|S" class="console">Xbox Series S|X</option>
          <option value="PlayStation" class="console">PS</option>
          <option value="PlayStation 2" class="console">PS2</option>
          <option value="PlayStation 3" class="console">PS3</option>
          <option value="PlayStation 4" class="console">PS4</option>
          <option value="PlayStation 5" class="console">PS5</option>
          <option value="PlayStation Portable" class="console">PSP</option>
          <option value="PlayStation Vita" class="console">PS Vita</option>
          <option value="Sega Master System/Mark III" class="console">Sega Master System</option>
          <option value="Sega Mega Drive/Genesis" class="console">Sega Mega Drive/Genesis</option>
          <option value="Sega Saturn" class="console">Sega Saturn</option>
          <option value="Dreamcast" class="console">Dreamcast</option>
          <option value="None" class="console">No Platform Data</option>
        </select>
      </div>
    </div>

    <div id="game-search">
      <h2>Search</h2>
      <input type="text" name="game-search" id="game-search-input" placeholder="Search...">
    </div>

    <div id="steam-search">
      <div id="steam-title">
        <h2>Steam ID Filter</h2>
        <span id="steam-information" tabindex="0">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" id="information-icon">
            <title>Steam Guide</title>
            <path d="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" />
          </svg>
        </span>
      </div>
      <div id="steam-inputs">
        <form action="/" method="post" id="steamid-input">
          <input type="text" name="steamid" id="steamid-input" placeholder="Enter Steam ID...">
          <button type="submit">Search</button>
        </form>
        <form action="/" method="get" id="steamid-clear">
          <button type="submit">Clear Steam Games</button>
        </form>
      </div>
    </div>

    <table id="games-list">
      <thead>
        <tr>
          <th>Game</th>
          <th>Stability</th>
          <th>PR Status</th>
          <th>18+?</th>
          <th>Platforms</th>
          <th>Links &amp; Downloads</th>
          <th>Setup Guides</th>
          <th>Support</th>
          <th>Disclosure</th>
        </tr>
      </thead>
      <tbody id="games-list-body">
        <% games.forEach(game => { %>
        <%- include("game-item.ejs", { game }) %>
        <% }); %>
      </tbody>
    </table>
  </main>
  <dialog id="steam-modal">
    <button id="steamid-close"> <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg></button>
    <div>
      <h2>What is this?</h2>
      <p>This allows you to enter your Steam ID and filter the list of games based on the games in your library</p>
      <p class="note">
        NOTE: Games shown may not be completly accurate since the games in the sheet do not have the exact Steam names.<br>
        Games with similar names cause false positives. It'll be mostly correct.
      </p>
    </div>
    <div>
      <h2>How do I Get my Steam ID?</h2>
      <ol id="steamid-steps">
        <li>1. Open Steam</li>
        <li>2. Click your profile in the top right &rarr; account details</li>
        <li>3. Look for Steam ID under your username</li>
      </ol>
      <img src="/assets/steamid-showcase.png" alt="demo of getting Steam ID" id="steamid-guide">
    </div>
  </dialog>
</body>

</html>